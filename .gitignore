# R / RStudio
.Rhistory
.RData
.Ruserdata
.Rproj.user/
*.Rproj

# Compiled native code (rebuilt from src/*.c on every install)
*.o
*.so
*.dll
*.dylib

# Package build artifacts
*.tar.gz
*.Rcheck/

# Vignette build artifacts
inst/doc/
vignettes/*.html
vignettes/*.pdf

# pkgdown (local builds into docs/, its default destination; CI deploys separately)
docs/

# macOS
.DS_Store

# testthat failure records (written by a failing run, never kept)
tests/testthat/_problems/
tests/testthat/testthat-problems.rds
