citHeader("To cite cellucid in publications use:")

package_version <- meta$Version

# The year is derived, not written down, for the reason CITATION.cff omits
# `date-released:`: this package has not been published yet, so a literal year
# committed here is a publication date claimed before the publication. It was
# also the one field in this entry nothing held in place -- the version beside
# it comes from meta$Version and is asserted by tests/testthat, while a
# hardcoded year is named by no release checklist and would have gone stale in
# silence the moment acceptance slipped into another year. Deriving it from the
# citing date is what base R itself does for a package with no
# Date/Publication, and it always yields exactly one string.
citation_year <- format(Sys.Date(), "%Y")

# The Cellucid preprint comes first, as the reference to cite. It is generated
# from the preferred-citation block of CITATION.cff, which is copied from the
# single source in theislab/cellucid/CITATION.cff; edit it there and run
# cellucid-private/scripts/sync_citation.py, never here.
# BEGIN cellucid-citation (generated by cellucid-private/scripts/sync_citation.py from CITATION.cff; do not edit) source-sha256=2486463f2b7c8cc656ae41e2df0261c1eb79780c4d635be147215f409b89aa2a body-sha256=59f22bef3d8280a9aacb12d9e70dc4a2b88a97a694d912b822032328cc34c8ad
bibentry(
  bibtype = "Unpublished",
  key = "cellucid",
  header = "Placeholder citation. The Cellucid preprint is in preparation for bioRxiv and has no DOI yet; the reference below is a placeholder and will be replaced when the preprint is published.",
  title = "PLACEHOLDER: Cellucid preprint, title to be announced (forthcoming on bioRxiv)",
  author = c(
    person("Kemal", "Inecik")
  ),
  note = "bioRxiv preprint in preparation. Placeholder citation without a DOI; it will be replaced when the preprint is published."
)
# END cellucid-citation

bibentry(
  bibtype = "Manual",
  title = "cellucid: Prepare and View Single-Cell Data in the Cellucid Viewer",
  author = person("Kemal", "Inecik"),
  year = citation_year,
  note = paste0("R package version ", package_version),
  url = "https://github.com/theislab/cellucid-r"
)
