\name{cellucid_highlight_page_combine}
\alias{cellucid_highlight_page_combine}
\title{Combine two highlight pages}
\usage{
cellucid_highlight_page_combine(viewer, pages, operation, name)
}
\arguments{
\item{viewer}{A viewer \code{\link{cellucid_view}()} or \code{\link{cellucid_serve}()} returned.}
\item{pages}{The two pages, by name. A vector or list of text (at least 1 character) (at least 2 items, at most 2 items, each once). Required.}
\item{operation}{Cells in both pages, or in either. One of \code{"intersection"}, \code{"union"}. Required.}
\item{name}{The new page's name; omitted, "A \ifelse{latex}{\eqn{\cap}}{∩} B" or "A \ifelse{latex}{\eqn{\cup}}{∪} B". Text (at least 1 character). Left out unless given (the viewer then chooses as its own control does).}
}
