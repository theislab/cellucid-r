\name{cellucid_camera_path_keyframe_add}
\alias{cellucid_camera_path_keyframe_add}
\title{Add a camera path keyframe}
\usage{
cellucid_camera_path_keyframe_add(viewer, camera, embedding, label)
}
\arguments{
\item{viewer}{A viewer \code{\link{cellucid_view}()} or \code{\link{cellucid_serve}()} returned.}
\item{camera}{The camera to save; omitted, the selected view's camera now. A named list. Left out unless given (the viewer then chooses as its own control does). \describe{\item{\code{freefly}}{A named list. Required. \describe{\item{\code{pitch}}{A number. Required.}\item{\code{position}}{A vector or list of a number (at least 3 items, at most 3 items). Required.}\item{\code{yaw}}{A number. Required.}}}\item{\code{navigationMode}}{"orbit", "planar" or "free" (free-fly). One of \code{"orbit"}, \code{"planar"}, \code{"free"}. Required.}\item{\code{orbit}}{A named list. Required. \describe{\item{\code{phi}}{A number. Required.}\item{\code{radius}}{A number (more than 0). Required.}\item{\code{target}}{A vector or list of a number (at least 3 items, at most 3 items). Required.}\item{\code{targetRadius}}{A number (more than 0). Required.}\item{\code{theta}}{A number. Required.}}}}}
\item{embedding}{The embedding the keyframe was recorded on; omitted, the one the selected view shows. Either a named list (An embedding: the obsm array and the columns of it plotted); or \code{NULL}. Left out unless given (the viewer then chooses as its own control does). \describe{\item{\code{columns}}{The 0-based columns plotted, one per dimension. A vector or list of a whole number (at least 0) (at least 1 item, at most 3 items, each once). Required.}\item{\code{key}}{The obsm key, "X_umap". Text (at least 1 character). Required.}}}
\item{label}{The keyframe's label; omitted, "KF n". Unique among the keyframes. Text (at least 1 character). Left out unless given (the viewer then chooses as its own control does).}
}
